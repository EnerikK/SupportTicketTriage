# Copy to .env and fill in real values. .env is gitignored.

POSTGRES_DB=supportickettriage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Azure OpenAI. The embedding deployment powers retrieval; the chat deployment
# powers classification. The two are read independently, so configuring one
# without the other works: you get retrieval without classification, or the
# reverse. Leave both blank to run with no AI at all - tickets still ingest,
# list and can be read, they simply get no embedding and no classification.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
# The groundedness judge (ADR-018). Must be a DIFFERENT and stronger deployment
# than the one above: a model scoring its own output exhibits self-preference,
# and the harness refuses to run if the two names match. Leave blank to skip
# groundedness, which is reported as not measured rather than scored zero.
AZURE_OPENAI_CHAT_DEPLOYMENT_STRONGER=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
