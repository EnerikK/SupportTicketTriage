# Copy to .env and fill in real values. .env is gitignored.

POSTGRES_DB=supportickettriage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Azure OpenAI - the embedding deployment is used from phase 2 onward; the chat
# deployment lands in phase 3. Leave blank to run without AI: tickets still
# ingest and list, they simply get no embedding.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
