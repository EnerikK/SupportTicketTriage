<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SupportTicketTriage.Application\SupportTicketTriage.Application.csproj" />
    <ProjectReference Include="..\SupportTicketTriage.Infrastructure\SupportTicketTriage.Infrastructure.csproj" />
    <ProjectReference Include="..\SupportTicketTriage.Domain\SupportTicketTriage.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generates the OpenAPI document from the endpoint signatures. The
         handlers return TypedResults unions, so every status code and payload
         shape comes from the method signature rather than from attributes
         that can drift away from the code. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Renders that document as a browsable reference. -->
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- Not used directly - pins the version so it matches Infrastructure's
         Npgsql provider instead of drifting to whatever floor version NuGet
         picks transitively through the project reference. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- dotnet-ef requires the Design package on the startup project, not
         just wherever the DbContext lives. Build-time only. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
